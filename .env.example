# API Settings
API_KEY=your_gemini_api_key_here

# App Settings
DEBUG=true
HOST=localhost
PORT=5000
SECRET_KEY=your-super-secret-key-change-this-in-production
PRODUCTION=false

# Database Settings
DATABASE_TYPE=sqlite  # sqlite or dynamodb

# DynamoDB Settings (only needed if DATABASE_TYPE=dynamodb)
# For local development with Docker:
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT_URL=http://localhost:8000

# DEPRECATED - Use specific table names instead
# DYNAMODB_TABLE_PREFIX=bank_details_

# DynamoDB Table Names
USERS_TABLE_NAME=users
HEADER_CONFIGS_TABLE_NAME=header-configs
RAW_EXTRACTIONS_TABLE_NAME=raw-extractions
PAYMENTS_TABLE_NAME=payments
USER_CREDENTIALS_TABLE_NAME=user-credentials

# DynamoDB Index Names
EMAIL_INDEX_NAME=email-index
GOOGLE_ID_INDEX_NAME=google-id-index
USER_ID_INDEX_NAME=user-id-index
YATIVO_DEPOSIT_ID_INDEX_NAME=yativo-deposit-id-index

# AWS Services Settings
USE_AWS_SECRETS=false
AWS_SECRETS_NAME=ai-bank-extractor
S3_BUCKET=ai-bank-extractor
USE_S3_STORAGE=false

# Authentication Settings
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Yativo Payment Gateway
YATIVO_SECRET_KEY=your_yativo_secret_key
YATIVO_BASE_URL=https://sandbox.yativo.com  # Use https://api.yativo.com for production